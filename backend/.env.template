# LucidFrame Backend Environment Variables
# Copy this file to .env and fill in your API keys

# VLM + LLM API Keys (at least one required)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Optional: Google Gemini
GEMINI_API_KEY=

# Model preferences (optional, defaults shown)
VLM_PROVIDER=openai          # openai | anthropic | gemini
LLM_PROVIDER=openai          # openai | anthropic | gemini

# Backend settings
HOST=0.0.0.0
PORT=8000

# Safety margins (0.20 = 20% reserved)
VRAM_SAFETY_MARGIN=0.20
RAM_SAFETY_MARGIN=0.20
CPU_SAFETY_MARGIN=0.20

# Pipeline settings
MULTIVIEW_MODEL=zero123pp    # zero123pp | sv3d
RECONSTRUCTION_MODEL=lgm     # lgm | depth_gsplat | splatter_image
DIFIX_MODE=structural        # structural | full | skip
MULTIVIEW_STEPS=75
