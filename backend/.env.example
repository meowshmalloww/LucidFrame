# ──────────────────────────────────────────────────────────────────────────────
# LucidFrame Environment Configuration Template
# Copy this file to backend/.env and fill in your API keys.
# The .env file is gitignored and will never be committed.
# ──────────────────────────────────────────────────────────────────────────────

# ── VLM Provider (image understanding / vision) ──────────────────────────────
# Choose ONE: gemini, groq, openrouter, openai, anthropic
VLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# ── LLM Provider (dream narrative text generation) ────────────────────────────
# Choose ONE: groq, gemini, openrouter, openai, anthropic
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here

# ── OpenRouter (universal fallback — routes to 100+ models) ───────────────────
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# VLM_MODEL=google/gemini-2.0-flash-exp:free
# LLM_MODEL=google/gemini-2.0-flash-exp:free

# ── Pipeline Settings ─────────────────────────────────────────────────────────
RECONSTRUCTION_MODEL=lgm
DIFIX_MODE=structural
SPLAT_STITCH=off
MULTIVIEW_STEPS=75

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
