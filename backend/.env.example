# ──────────────────────────────────────────────────────────────────────────────
# LucidFrame Environment Configuration Template
# Copy this file to backend/.env and fill in your API keys.
# The .env file is gitignored and will never be committed.
# ──────────────────────────────────────────────────────────────────────────────

# ── VLM Provider (image understanding / vision) ──────────────────────────────
# Choose ONE: gemini, groq, openrouter, nim, mistral, openai, anthropic
VLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# ── LLM Provider (dream narrative text generation) ────────────────────────────
# Choose ONE: groq, gemini, cerebras, nim, mistral, openrouter, openai, anthropic
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here

# ── OpenRouter (universal fallback — routes to 100+ models) ───────────────────
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# VLM_MODEL=google/gemini-2.0-flash-exp:free
# LLM_MODEL=google/gemini-2.0-flash-exp:free

# ── Cerebras (ultra-fast LLM, text-only) ─────────────────────────────────────
# CEREBRAS_API_KEY=your-cerebras-api-key-here

# ── NVIDIA NIM (OpenAI-compatible, has vision) ───────────────────────────────
# NIM_API_KEY=your-nim-api-key-here

# ── Mistral (vision via Pixtral, text via Mistral Large) ──────────────────────
# MISTRAL_API_KEY=your-mistral-api-key-here

# ── Image Generation (optional, for input enhancement) ───────────────────────
# Provider: pollinations (default, no key), cloudflare, huggingface, pixazo
IMAGE_GEN_PROVIDER=pollinations
# CF_API_TOKEN=your-cf-token
# CF_ACCOUNT_ID=your-cf-account-id
# HF_TOKEN=your-hf-token
# PIXAZO_API_KEY=your-pixazo-key

# ── Multi-View Settings ──────────────────────────────────────────────────────
MULTIVIEW_MODEL=zero123pp
USE_IP_ADAPTER=true
MULTIVIEW_STEPS=75

# ── Pipeline Settings ─────────────────────────────────────────────────────────
# Reconstruction model:
#   depth_direct   = single-image depth backprojection, best for rooms/scenes
#   depth_gsplat   = depth backprojection + fake-orbit optimization (legacy)
#   lgm            = Zero123++ views + LGM feed-forward (object-centric)
#   splatter_image = one Gaussian per pixel (ultra-light)
RECONSTRUCTION_MODEL=depth_direct

# Multi-view hallucination: on (Zero123++), off (skip for depth_direct)
MULTIVIEW_ENABLED=off

# Difix3D+ artifact fixing mode: structural, full, skip
DIFIX_MODE=skip

# Splat stitching (expand hallucinated space): on, off
SPLAT_STITCH=off

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
